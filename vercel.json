{
    "version": 2,
    "builds": [
      {
        "src": "api/resolve.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/resolve",
        "dest": "/api/resolve.js"
      },
      {
        "src": "/(.*)",
        "dest": "/api/resolve.js"
      }
    ]
  }